---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { topics } from '../config';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 1. On trie les articles du plus récent au plus ancien
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 2. On récupère la catégorie du tout dernier article
const mostRecentCategory = sortedPosts[0]?.data.category;

// 3. On filtre ta liste de topics globale pour enlever la plus récente (si elle y est)
// pour éviter qu'elle n'apparaisse deux fois
const cleanTopics = topics.filter(topic => topic !== mostRecentCategory);

// 4. On assemble le tout : "Tous" -> La plus récente -> Tout le reste de tes thèmes
const categories = ['Tous'];

if (mostRecentCategory) {
	categories.push(mostRecentCategory);
}

categories.push(...cleanTopics);

// // On ajoute "Tous" pour pouvoir réinitialiser le filtre
// const categories = ['Tous', ...topics];
---

<Layout title="Phéni-x Blog | Explorer les Topics">
	<div class="max-w-298 mx-auto relative group">
		<h1 class="text-5xl md:text-6xl font-bold font-['Source_Serif_4'] tracking-tight leading-tight mb-4">
			L'actualité décryptée par <br />
			<span class="text-indigo-600 italic">Phénix.</span>
		</h1>
		<p class="text-lg md:text-xl text-gray-500 font-medium leading-relaxed">Une veille intelligente sur la tech, le business et la culture.</p>

		<div
			class="border-b border-gray-100 mb-8 sticky top-16.25 bg-white/95 backdrop-blur-sm z-40 dark:bg-[#121212] dark:border-gray-700 mx-auto w-full">
			<div class="max-w-298 mx-auto relative group">
				<div id="category-nav" class="flex gap-6 overflow-x-auto no-scrollbar py-4 px-4 pr-20 text-sm text-gray-500 dark:text-gray-400 scroll-smooth">
					{
						categories.map((cat, index) => (
							<a
								href="#"
								data-category={cat}
								class={`filter-btn whitespace-nowrap capitalize transition-all duration-200 pb-4 -mb-4.25 border-b-2 font-medium shrink-0 dark:text-gray-400 dark:hover:text-white cursor-pointer
              ${index === 0 ? 'text-black border-black dark:text-white dark:border-white ' : 'border-transparent hover:text-black '}`}>
								{cat}
							</a>
						))
					}
				</div>
			</div>
		</div>

		<!-- <div>
			<script async="async" data-cfasync="false" src="https://revolthem.com/df6eb799ea4c379317952962e4b42c27/invoke.js"></script>
			<div id="container-df6eb799ea4c379317952962e4b42c27"></div>
		</div> -->

		<div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-15">
			{
				posts.map((post, index) => (
					<>
						{/* L'ARTICLE DE BLOG CLASSIQUE */}
						<a
							href={`/blog/${post.id}`}
							data-category={post.data.category}
							class="post-card group flex flex-col cursor-pointer transition-all duration-300 double-click-ad ">
							<div class="aspect-video mb-4 overflow-hidden bg-gray-100 rounded-sm">
								{post.data.heroImage && (
									<img src={post.data.heroImage} alt={post.data.title} class="w-full aspect-video object-cover rounded-xs mb-10 shadow-lg" />
								)}
							</div>
							<div class="flex items-center gap-2 mb-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-indigo-600">{post.data.category}</span>
								<span class="text-gray-300">·</span>
								<time class="text-xs text-gray-500">{post.data.pubDate.toLocaleDateString('fr-FR', { month: 'short', day: 'numeric' })}</time>
							</div>

							<h2 class="text-xl font-bold font-['Source_Serif_4'] leading-tight mb-2 group-hover:text-gray-600 transition-colors dark:group-hover:text-gray-300">
								{post.data.title}
							</h2>

							<p class="text-gray-500 text-sm line-clamp-3 font-['Source_Serif_4'] leading-relaxed mb-5">{post.data.description}</p>
							<div class="mt-auto flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-black dark:text-white group-hover:text-gray-800 dark:group-hover:text-gray-300 transition-colors">
								En savoir plus
								<span class="transform group-hover:translate-x-1 transition-transform duration-200  mb-1">→</span>
							</div>
						</a>
					</>
				))
			}

			<!-- 


			{
				(index + 1) % 20 === 0 && (
					<div data-ad-index={index} class=" ad-card  flex flex-col  bg-gray-50/50 dark:bg-[#151515]/50 border border-gray-100 dark:border-gray-800 p-4 rounded-sm transition-all duration-300 w-5 min-h-100">
						
						<div class="aspect-video mb-4 flex flex-col items-center justify-center bg-gray-100 dark:bg-[#202020] rounded-xs  p-2">
							<span class="text-[9px] uppercase tracking-widest text-gray-400 font-bold mb-1">Sponsorisé</span>
							
						<script is:inline>
								window.atOptions = {
									'key' : '3b11c1230d524bad00b0100f13fcce04',
									'format' : 'iframe',
									'height' : 250,
									'width' : 300,
									'params' : {}
								};
							</script>
							<script is:inline src="https://revolthem.com/3b11c1230d524bad00b0100f13fcce04/invoke.js"></script>

						</div>

						{/* Faux contenu textuel en dessous pour imiter parfaitement les autres blocs */}
						<div class="flex items-center gap-2 mb-2">
							<span class="text-[10px] font-bold uppercase tracking-widest text-indigo-400">Annonce</span>
						</div>
					
					</div>
				)
			
			}
-->
		</div>

		<div id="empty-state" class="hidden flex-col items-center justify-center py-20 text-center">
			<div class="text-4xl mb-4">🌵</div>
			<h3 class="text-xl font-bold font-['Source_Serif_4'] dark:text-white">Silence radio...</h3>
			<p class="text-gray-500 dark:text-gray-400 max-w-xs mx-auto mt-2">
				Il n'y a pas encore d'articles dans cette catégorie. Phénix est en train de couver de nouveaux sujets.
			</p>
		</div>
	</div>
</Layout>

<script>
	const nav = document.getElementById('category-nav');
	const filterButtons = document.querySelectorAll('.filter-btn');
	const postCards = document.querySelectorAll('.post-card');

	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const targetCat = btn.getAttribute('data-category');

			// 1. Gérer l'état visuel (soulignement noir)
			filterButtons.forEach(b => {
				b.classList.remove('text-black', 'border-black', 'dark:text-white', 'dark:border-white');
				// On remet l'état inactif
				b.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
			});
			btn.classList.add('text-black', 'border-black', 'dark:text-white', 'dark:border-white');
			btn.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
			// 2. Faire défiler le topic cliqué vers le centre de la barre
			btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

			// 3. Filtrage dynamique
			postCards.forEach(card => {
				const cardCat = card.getAttribute('data-category');
				if (targetCat === 'Tous' || cardCat === targetCat) {
					(card as HTMLElement).style.display = 'flex';
					(card as HTMLElement).style.opacity = '1';
				} else {
					(card as HTMLElement).style.display = 'none';
					(card as HTMLElement).style.opacity = '0';
				}
			});
		});
	});

	// Support de la molette pour le défilement horizontal
	nav?.addEventListener(
		'wheel',
		e => {
			if (e.deltaY !== 0) {
				e.preventDefault();
				// Utilise scrollTo pour un contrôle plus fin si nécessaire
				nav.scrollBy({
					left: e.deltaY * 2, // Multiplie pour ajuster la vitesse
					behavior: 'smooth',
				});
			}
		},
		{ passive: false }
	);

	const emptyState = document.getElementById('empty-state');

	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const targetCat = btn.getAttribute('data-category');
			let visibleCount = 0; // Compteur pour l'état vide

			// 1. État visuel des boutons (ton code existant)
			// ...

			// 2. Filtrage dynamique
			postCards.forEach(card => {
				const cardCat = card.getAttribute('data-category');
				const htmlCard = card as HTMLElement;

				if (targetCat === 'Tous' || cardCat === targetCat) {
					htmlCard.style.display = 'flex';
					htmlCard.style.opacity = '1';
					visibleCount++; // On incrémente si on affiche
				} else {
					htmlCard.style.display = 'none';
					htmlCard.style.opacity = '0';
				}
			});

			// 3. Gestion de l'Empty State
			if (visibleCount === 0) {
				emptyState?.classList.remove('hidden');
				emptyState?.classList.add('flex');
				document.getElementById('posts-grid')?.classList.add('hidden');
			} else {
				emptyState?.classList.add('hidden');
				emptyState?.classList.remove('flex');
				document.getElementById('posts-grid')?.classList.remove('hidden');
			}
		});
	});

	const adCards = document.querySelectorAll('.ad-card'); // Récupération des pubs
	const postsGrid = document.getElementById('posts-grid');

	// Fonction maîtresse qui gère le filtrage, l'affichage et l'ordre (order)
	function filterArticles(targetCat: any) {
		let visibleArticlesCount = 0;

		// 1. On cache initialement toutes les publicités
		adCards.forEach(ad => {
			(ad as HTMLElement).style.display = 'none';
		});

		// 2. On parcourt les articles pour filtrer et modifier l'ordre CSS Grid
		postCards.forEach((card, index) => {
			const cardCat = card.getAttribute('data-category');
			const htmlCard = card as HTMLElement;
			// On trouve la pub associée à l'index de cet article
			const associatedAd = document.querySelector(`[data-ad-index="${index}"]`) as HTMLElement;

			if (targetCat === 'Tous' || cardCat === targetCat) {
				htmlCard.style.display = 'flex';
				htmlCard.style.opacity = '1';
				visibleArticlesCount++; // On compte l'article car il est visible

				if (targetCat === 'Tous') {
					// 🌟 CAS "TOUS" : Ordre naturel standard, les pubs s'intercalent
					htmlCard.style.order = '0';
					if (associatedAd) associatedAd.style.order = '0';

					// On affiche la pub après le 20e, 40e... article
					if (visibleArticlesCount % 20 === 0 && associatedAd) {
						associatedAd.style.display = 'flex';
					}
				} else {
					// 🌟 CAS CATÉGORIE : Articles d'abord (order-1), Pubs à la fin (order-2)
					htmlCard.style.order = '1';
					if (associatedAd) {
						associatedAd.style.order = '2';

						// Si la catégorie contient plus de 20 articles, on affiche la pub (à la fin)
						if (visibleArticlesCount % 20 === 0) {
							associatedAd.style.display = 'flex';
						}
					}
				}
			} else {
				htmlCard.style.display = 'none';
				htmlCard.style.opacity = '0';
			}
		});

		// 3. Gestion de l'état vide (Empty State)
		if (visibleArticlesCount === 0) {
			emptyState?.classList.remove('hidden');
			emptyState?.classList.add('flex');
			postsGrid?.classList.add('hidden');
		} else {
			emptyState?.classList.add('hidden');
			emptyState?.classList.remove('flex');
			postsGrid?.classList.remove('hidden');
		}
	}

	// Gestion des clics sur les boutons de catégorie
	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const targetCat = btn.getAttribute('data-category');

			// Mise à jour visuelle des boutons
			filterButtons.forEach(b => {
				b.classList.remove('text-black', 'border-black', 'dark:text-white', 'dark:border-white');
				b.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
			});
			btn.classList.add('text-black', 'border-black', 'dark:text-white', 'dark:border-white');
			btn.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');

			// Centrage du bouton cliqué
			btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

			// Exécution du filtrage intelligent
			filterArticles(targetCat);
		});
	});

	// 🚀 Lancement initial automatique sur "Tous" au chargement de la page
	filterArticles('Tous');

	// Défilement horizontal fluide avec la molette de la souris
	nav?.addEventListener(
		'wheel',
		e => {
			if (e.deltaY !== 0) {
				e.preventDefault();
				nav.scrollBy({
					left: e.deltaY * 2,
					behavior: 'smooth',
				});
			}
		},
		{ passive: false }
	);
</script>

<style>
	/* Supprime la barre de défilement moche tout en gardant le scroll */
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* Ajoute un petit fondu pour indiquer qu'il y a plus de thèmes à droite */
	#category-nav {
		mask-image: linear-gradient(to right, black 85%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
		display: flex;
		gap: 1.5rem;
		overflow-x: auto;
		scroll-behavior: smooth; /* Défilement fluide pour le JS */
		-webkit-overflow-scrolling: touch; /* Inertie sur iOS */
		scroll-snap-type: x mandatory; /* Force l'alignement */
	}
	.filter-btn {
		scroll-snap-align: center; /* Aligne le bouton au centre lors du scroll */
	}
	#category-nav {
		/* Masque progressif à gauche et à droite */
		mask-image: linear-gradient(to right, transparent, black 5%, black 90%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 90%, transparent);
	}
</style>
