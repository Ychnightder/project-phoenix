---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contactez Phénix | Support et Partenariats"
	description="Besoin d'informations sur nos veilles technologiques ? Contactez l'équipe de Phénix AI.">
	<div class="max-w-4xl mx-auto py-12 px-4">
		<header class="mb-12">
			<h1 class="text-4xl md:text-5xl font-bold font-['Source_Serif_4'] mb-4 dark:text-white">Contact.</h1>
			<p class="text-lg text-gray-600 dark:text-gray-400">
				Une question sur un article ? Une proposition de partenariat ? Notre équipe (et nos algorithmes) vous répondent sous 48h.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
			<section>
				<form id="contact-form" class="space-y-6">
					<div>
						<label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nom complet</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="w-full px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 dark:bg-[#1a1a1a] dark:text-white focus:ring-2 focus:ring-indigo-600 outline-none transition-all"
						/>
					</div>

					<div>
						<label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="w-full px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 dark:bg-[#1a1a1a] dark:text-white focus:ring-2 focus:ring-indigo-600 outline-none transition-all"
						/>
					</div>

					<div>
						<label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Sujet</label>
						<select
							id="subject"
							name="subject"
							class="w-full px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 dark:bg-[#1a1a1a] dark:text-white focus:ring-2 focus:ring-indigo-600 outline-none transition-all">
							<option>Information générale</option>
							<option>Partenariat / Publicité</option>
							<option>Signaler une erreur IA</option>
						</select>
					</div>

					<div>
						<label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Message</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							class="w-full px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 dark:bg-[#1a1a1a] dark:text-white focus:ring-2 focus:ring-indigo-600 outline-none transition-all"
						></textarea>
					</div>

					<button
						type="submit"
						id="submit-btn"
						class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-lg transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
						Envoyer le message
					</button>

					<p id="form-status" class="hidden text-sm mt-4 text-center font-medium"></p>
				</form>
			</section>

			<aside class="space-y-8">
				<div>
					<h3 class="text-lg font-bold mb-3 dark:text-white">Informations légales</h3>
					<p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
						Phénix Blog est un projet d'expérimentation technologique. <br />
						Propulsé par le modèle Groq et Astro.
					</p>
				</div>

				<div>
					<h3 class="text-lg font-bold mb-3 dark:text-white">Email direct</h3>
					<a href="mailto:contact@phenix-blog.com" class="text-indigo-600 hover:underline font-medium">contact@phenix-blog.com</a>
				</div>

				<div>
					<h3 class="text-lg font-bold mb-3 dark:text-white">Réseaux Sociaux</h3>
					<div class="flex gap-4">
						<a href="#" class="p-2 bg-gray-100 dark:bg-gray-800 rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900 transition-colors">
							<span class="sr-only">LinkedIn</span>
							<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
								><path
									d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
								></path></svg
							>
						</a>
						<a href="#" class="p-2 bg-gray-100 dark:bg-gray-800 rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900 transition-colors">
							<span class="sr-only">Twitter</span>
							<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
								><path
									d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"
								></path></svg
							>
						</a>
					</div>
				</div>

				<div class="p-6 bg-indigo-50 dark:bg-indigo-950/30 rounded-2xl border border-indigo-100 dark:border-indigo-900/50">
					<h3 class="text-indigo-900 dark:text-indigo-300 font-bold mb-2">Transparence IA</h3>
					<p class="text-xs text-indigo-800/80 dark:text-indigo-400/80 leading-relaxed">
						Le contenu de ce blog est généré par intelligence artificielle. Pour toute demande de rectification ou de retrait de contenu, veuillez
						utiliser ce formulaire en précisant l'URL de l'article concerné.
					</p>
				</div>
			</aside>

			<!-- <div class="absolute top-40 right-0 p-4">
				<script is:inline>
					window.atOptionsRight = {
						key: '482d887ca4f7414d4b9129d9a6514931',
						format: 'iframe',
						height: 600,
						width: 160,
						params: {},
					};
					window.atOptions = window.atOptionsRight;
				</script>
				<script is:inline src="https://revolthem.com/482d887ca4f7414d4b9129d9a6514931/invoke.js"></script>
			</div>

			<div class="absolute top-40 left-0 p-4">
				<script is:inline>
					window.atOptionsLeft = {
						key: '482d887ca4f7414d4b9129d9a6514931',
						format: 'iframe',
						height: 600,
						width: 160,
						params: {},
					};
					window.atOptions = window.atOptionsLeft;
				</script>
				<script is:inline src="https://revolthem.com/482d887ca4f7414d4b9129d9a6514931/invoke.js"></script>
			</div> -->
		</div>
	</div>

	<script>
		const contactForm = document.getElementById('contact-form') as HTMLFormElement;
		const statusMsg = document.getElementById('form-status');
		const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

		contactForm?.addEventListener('submit', async e => {
			e.preventDefault();

			// 1. UI Loading State
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.innerText = 'Transmission en cours...';
			}

			if (statusMsg) {
				statusMsg.classList.add('hidden');
			}

			const formData = new FormData(contactForm);

			try {
				// 2. Appel de l'API Nodemailer
				const response = await fetch('/api/send-email', {
					method: 'POST',
					body: formData,
				});

				const result = await response.json();

				if (response.ok) {
					// 3. Succès
					updateStatus('✅ Message envoyé ! Nous reviendrons vers vous rapidement.', 'text-green-600 dark:text-green-400');
					contactForm.reset();
				} else {
					// 4. Erreur côté serveur
					updateStatus(`❌ Erreur : ${result.message}`, 'text-red-600 dark:text-red-400');
				}
			} catch (error) {
				// 5. Erreur réseau
				updateStatus('❌ Impossible de joindre le serveur. Vérifiez votre connexion.', 'text-red-600 dark:text-red-400');
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.innerText = 'Envoyer le message';
				}
			}
		});

		function updateStatus(message: string, colorClass: string) {
			if (statusMsg) {
				statusMsg.innerText = message;
				statusMsg.className = `text-sm mt-4 text-center font-medium ${colorClass}`;
				statusMsg.classList.remove('hidden');
			}
		}
	</script>
</Layout>
