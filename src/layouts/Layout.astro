---
interface Props {
	title: string;
	description?: string;
	image?: string;
	articleDate?: Date;
}

const { 
	title, 
	description = "Phénix : Votre veille intelligente sur l'IA, la tech et le business.", 
	image = "/default-og.jpg", // Crée une image par défaut dans public/
	articleDate 
} = Astro.props;

import '../styles/global.css';

---

<!doctype html>
<html lang="fr">

	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />

		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
		<link rel="manifest" href="/favicon/site.webmanifest">	
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<meta property="og:type" content={articleDate ? "article" : "website"} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />

		<meta http-equiv="X-Frame-Options" content="DENY">

		<meta http-equiv="Cross-Origin-Opener-Policy" content="same-origin">

		<meta name="google-site-verification" content="Ric8gIiW4SkkmSmA9djZ1uO6Zg720S884xBEyH9RK_Y" />
		
		<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-white text-[#242424] font-['Inter'] antialiased">
		<nav class="h-16.25 border-b border-gray-100 sticky top-0 bg-white/95 backdrop-blur-sm z-50">
			<div class="max-w-298 mx-auto px-6 h-full flex items-center justify-between">
				<a href="/" class="text-2xl font-bold tracking-tighter hover:opacity-80 transition-opacity">Phénix.</a>
				<div class="hidden md:flex gap-6 text-sm font-medium text-gray-500">
					<a href="/" class="hover:text-black">Accueil</a>
					<span class="cursor-not-available opacity-50">Newsletter</span>
				</div>
			</div>
		</nav>
		<main class="max-w-298 mx-auto px-6 py-12">
			<slot />
		</main>
		<footer class="border-t border-gray-100 py-10 mt-20 text-center text-sm text-gray-400">
			© {new Date().getFullYear()} Phénix Blog - Intelligence Artificielle & Veille Tech
		</footer>
		
	</body>
	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-RQGRZV259S"></script>
	<script src="./google.js" defer></script>

</html>

