---
interface Props {
	title: string;
	description?: string;
	image?: string;
	articleDate?: Date;

}

const {
	title,
	description = "Phénix : Votre veille intelligente sur l'IA, la tech et le business.",
	image = '/1920x1080.svg',
	articleDate,
} = Astro.props;

import '../styles/global.css';
import NewsletterModal from '../components/NewsletterModal.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
const adCount = Array.from({ length: 0 });
---

<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />

		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<meta property="og:type" content={articleDate ? 'article' : 'website'} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />

		<meta name="pinterest-rich-pin" content="false" />
		<link rel="alternate" type="application/rss+xml" title="Phénix Blog RSS Feed" href={`${Astro.site}rss.xml`} />
		<!-- <meta http-equiv="X-Frame-Options" content="DENY" /> -->

		<meta http-equiv="Cross-Origin-Opener-Policy" content="same-origin" />

		<meta name="google-site-verification" content="Ric8gIiW4SkkmSmA9djZ1uO6Zg720S884xBEyH9RK_Y" />

		<meta name="google-adsense-account" content="ca-pub-2963192094845544" />

		<link
			href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "Phénix Blog",
				"url": "https://phenix-blog.vercel.app/"
			}
		</script>

		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2963192094845544" crossorigin="anonymous"
		></script>

		<script is:inline>
			const savedTheme = localStorage.getItem('theme');

			if (savedTheme === 'dark') {
				document.documentElement.classList.add('dark');
			}

			document.addEventListener('DOMContentLoaded', () => {
				const button = document.getElementById('themeToggle');

				if (!button) return;

				button.addEventListener('click', () => {
					document.documentElement.classList.toggle('dark');

					const isDark = document.documentElement.classList.contains('dark');

					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
			});
		</script>
		<meta name="msvalidate.01" content="69A3FC057076A2EFD9E7C8E1A115953C" />
	</head>
	<body class="bg-white text-[#121212] dark:bg-[#121212] dark:text-gray-100 font-['Inter'] antialiased">
		<NewsletterModal />
		<nav class="h-16.25 border-b border-gray-100 sticky top-0 bg-white/95 dark:bg-[#121212] dark:text-gray-100 dark:border-gray-700 backdrop-blur-sm z-50">
			<div class="max-w-298 mx-auto px-6 h-full flex items-center justify-between relative">
				
				<!-- --- LOGO --- -->
				<a href="/" class="text-2xl font-bold tracking-tighter hover:opacity-80 transition-opacity">Phénix.</a>

				<!-- --- MENU DESKTOP --- -->
				<div class="hidden md:flex gap-6 text-sm font-medium text-gray-500 dark:text-gray-400 items-center">
					<span>|</span>
					<a href="/" class="hover:text-black dark:hover:text-gray-100 transition-colors">Accueil</a>
					<span>|</span>
					<a href="/contact" class="hover:text-black dark:hover:text-gray-100 transition-colors">Contact</a>
					<span>|</span>
					<button id="open-newsletter" class="hover:text-black dark:hover:text-gray-100 cursor-pointer transition-colors">Newsletter</button>
					<span>|</span>
				</div>
				
				<!-- --- ACTIONS EN CARTES (Thème + Hamburger) --- -->
				<div class="flex items-center gap-4 z-50">
					<!-- Bouton Thème (Accessible sur tous les écrans) -->
					<button
						id="themeToggle"
						class="group relative flex items-center justify-center w-8 h-8 sm:w-11 sm:h-11 rounded-full border border-gray-400 bg-white/80 backdrop-blur-sm shadow-sm transition-all duration-300 cursor-pointer hover:scale-105 hover:bg-gray-100 hover:shadow-md dark:border-gray-700 dark:bg-[#1e1e1e]/80 dark:hover:bg-[#2a2a2a]"
						aria-label="Changer le thème">
						<!-- Icône lune -->
						<span class="absolute text-base sm:text-lg transition-all duration-300 rotate-0 scale-100 dark:-rotate-90 dark:scale-0"> 🌙 </span>
						<!-- Icône soleil -->
						<span class="absolute text-base sm:text-lg transition-all duration-300 rotate-90 scale-0 dark:rotate-0 dark:scale-100"> ☀️ </span>
					</button>

					<!-- Bouton Hamburger (Visible uniquement sur mobile) -->
					<button 
						id="mobile-menu-button" 
						class="flex md:hidden flex-col justify-center items-center w-8 h-8 gap-1.5 text-gray-500 hover:text-black dark:hover:text-gray-100 cursor-pointer"
						aria-label="Ouvrir le menu"
					>
						<span class="w-6 h-0.5 bg-current transform transition-all duration-300 origin-center id-bar-1"></span>
						<span class="w-6 h-0.5 bg-current transition-all duration-300 id-bar-2"></span>
						<span class="w-6 h-0.5 bg-current transform transition-all duration-300 origin-center id-bar-3"></span>
					</button>
				</div>

				<!-- --- DROPDOWN TIROIR MOBILE --- -->
				<div 
    id="mobile-menu" 
    class="hidden fixed top-[65px] left-0 w-full h-[calc(100vh-65px)] bg-white/95 dark:bg-[#121212]/95 backdrop-blur-md z-40 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col items-center justify-start pt-16 gap-8 text-lg font-semibold text-gray-600 dark:text-gray-300 border-t border-gray-100 dark:border-gray-800"
>
    <a href="/" class="hover:text-black dark:hover:text-gray-100 transition-colors w-full text-center py-2">Accueil</a>
    <a href="/contact" class="hover:text-black dark:hover:text-gray-100 transition-colors w-full text-center py-2">Contact</a>
    <button id="open-newsletter-mobile" class="hover:text-black dark:hover:text-gray-100 cursor-pointer transition-colors w-full text-center py-2">
        Newsletter
    </button>
</div>

			</div>
		</nav>
		<main class="flex justify-center gap-8 px-4 sm:px-10 py-12">
			<aside class="hidden xl:flex flex-col gap-6 w-[200px] shrink-0 mt-60">
				<div class="sticky flex flex-col gap-6">
					<div class="sticky top-24 flex flex-col gap-6">
						{adCount.map((_, index) => <AdPlaceholder format="sidebar" `} />)}
					</div>
				</div>
			</aside>

			<div class="max-w-[1850px] flex-1 min-w-0">
				<div class="prose prose-slate dark:prose-invert max-w-none">
					<slot />
				</div>
			</div>

			<aside class="hidden xl:flex flex-col gap-6 w-[200px] shrink-0 mt-60">
				<div class="sticky flex flex-col gap-6">
					<div class="sticky top-24 flex flex-col gap-6">
						{adCount.map((_, index) => <AdPlaceholder format="sidebar"  />)}
					</div>
				</div>
			</aside>
		</main>
		<footer class="border-t border-gray-100 py-10 mt-20">
			<div class="max-w-298 mx-auto px-6 flex justify-between items-center text-sm text-gray-500">
				<p class="">© {new Date().getFullYear()} Phénix. Tous droits réservés.</p>
				<div class="flex gap-6">
					<a href="/consent" class="hover:text-black">Confidentialité</a>
					<a href="/contact" class="hover:text-black">Contact</a>
				</div>
			</div>
		</footer>
	</body>
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-RQGRZV259S"></script>
	<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag() {
			dataLayer.push(arguments);
		}
		gtag('js', new Date());

		gtag('config', 'G-RQGRZV259S');
	</script>
	<script>
		// Script pour ouvrir la modal depuis le menu
		document.getElementById('open-newsletter')?.addEventListener('click', () => {
			const modal = document.getElementById('newsletter-modal');
			modal?.classList.remove('hidden');
		});


	const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    const bar1 = menuButton?.querySelector('.id-bar-1');
    const bar2 = menuButton?.querySelector('.id-bar-2');
    const bar3 = menuButton?.querySelector('.id-bar-3');

    menuButton?.addEventListener('click', () => {
        if (mobileMenu) {
            // Si le menu contient "hidden", on le passe en "flex" avant l'animation
            if (mobileMenu.classList.contains('hidden')) {
                mobileMenu.classList.remove('hidden');
                mobileMenu.classList.add('flex');
                // Petit timeout pour laisser le navigateur enregistrer le display:flex avant la transition
                setTimeout(() => {
                    mobileMenu.classList.remove('translate-x-full');
                }, 10);
            } else {
                // Si on ferme, on fait d'abord la transition vers la droite
                mobileMenu.classList.add('translate-x-full');
                // Puis on le cache complètement après la fin de l'animation (300ms)
                setTimeout(() => {
                    mobileMenu.classList.remove('flex');
                    mobileMenu.classList.add('hidden');
                }, 300);
            }
        }
        
        // Animation du bouton Hamburger vers une croix (X)
        bar1?.classList.toggle('rotate-45');
        bar1?.classList.toggle('translate-y-2');
        
        bar2?.classList.toggle('opacity-0');
        
        bar3?.classList.toggle('-rotate-45');
        bar3?.classList.toggle('-translate-y-2');
        
        document.body.classList.toggle('overflow-hidden');
    });

    // Gestion de la newsletter sur mobile
    const newsletterMobileBtn = document.getElementById('open-newsletter-mobile');
    newsletterMobileBtn?.addEventListener('click', () => {
        menuButton?.click();
        setTimeout(() => {
            document.getElementById('open-newsletter')?.click();
        }, 350); // Ajusté à 350ms pour attendre la disparition complète du volet
    });
	</script>
</html>
