---
interface Props {
	format: 'leaderboard' | 'rectangle' | 'sidebar';
}

const { format } = Astro.props;

const dimensions = {
	leaderboard: 'w-full h-[90px]', // Bannière horizontale
	rectangle: 'w-[300px] h-[250px]', // Carré classique
	sidebar: 'w-full h-[600px]', // Bannière verticale
};
---

<div
	class={`bg-gray-100 dark:bg-gray-800 border-2 border-dashed border-gray-300 dark:border-gray-700 flex flex-col items-center justify-center rounded-lg my-8 ${dimensions[format]}`}>
	<span class="text-xs font-bold uppercase tracking-widest text-gray-400">Sponsorisé</span>
	<div class="mt-2 text-gray-500 flex flex-col items-center">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
			></path>
		</svg>
		<p class="text-[10px] mt-1 italic opacity-50">Espace publicitaire Phénix</p>
	</div>
</div>
